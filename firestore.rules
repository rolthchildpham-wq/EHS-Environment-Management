rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
  function activeMember() {
    return signed() && exists(memberPath()) &&
      get(memberPath()).data.get('active', true) == true;
  }
  function role() { return get(memberPath()).data.role; }
  function admin() { return activeMember() && role() == 'admin'; }
  function editor() { return activeMember() && role() in ['admin','editor']; }
  function validRole(r) { return r in ['admin','editor','viewer']; }
  function validKind(k) { return k in ['waste','water_in','water_out','stock_in','stock_out','cost','revenue']; }
  function validEntry(d) {
    return d.keys().hasAll(['date','kind','value','unit','name','note','source','createdBy','createdAt'])
      && d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && validKind(d.kind)
      && d.value is number && d.value >= 0
      && d.unit is string && d.unit.size() <= 32
      && d.name is string && d.name.size() <= 200
      && d.note is string && d.note.size() <= 2000
      && d.source is string && d.source.size() <= 32
      && d.createdBy == request.auth.uid
      && d.createdAt == request.time;
  }
  function hasAudit(target, id) {
    return id is string
      && existsAfter(/databases/$(database)/documents/member_audit/$(id))
      && getAfter(/databases/$(database)/documents/member_audit/$(id)).data.target == target
      && getAfter(/databases/$(database)/documents/member_audit/$(id)).data.actorUid == request.auth.uid
      && getAfter(/databases/$(database)/documents/member_audit/$(id)).data.occurredAt == request.time;
  }

  match /members/{uid} {
    allow get: if signed() && (request.auth.uid == uid || admin());
    allow list: if admin();
    // A signed-in invitee may activate only their own UID and only an active email invitation.
    allow create: if signed() && request.auth.uid == uid
      && request.auth.token.email_verified == true
      && request.resource.data.keys().hasOnly(['email','role','active','inviteEmail','createdAt','acceptedAt'])
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.inviteEmail == request.auth.token.email
      && request.resource.data.active == true
      && request.resource.data.createdAt == request.time
      && request.resource.data.acceptedAt == request.time
      && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
      && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.active == true
      && request.resource.data.role ==
         get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role;
    allow update: if admin()
      && uid != request.auth.uid
      && resource.data.role is string
      && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['role','active','updatedAt','lastAuditId'])
      && validRole(request.resource.data.role)
      && request.resource.data.active is bool
      && request.resource.data.updatedAt == request.time
      && request.resource.data.lastAuditId is string
      && request.resource.data.lastAuditId != resource.data.get('lastAuditId','')
      && hasAudit('members/'+uid,request.resource.data.lastAuditId);
    allow delete: if false;
  }

  match /invites/{email} {
    allow get: if admin() || (signed() && request.auth.token.email_verified == true
                             && request.auth.token.email == email);
    allow list: if admin();
    allow create: if admin()
      && request.resource.data.keys().hasOnly(['email','role','active','createdAt','updatedAt','createdBy','lastAuditId'])
      && request.resource.data.email == email
      && validRole(request.resource.data.role)
      && request.resource.data.active == true
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time
      && hasAudit('invites/'+email,request.resource.data.lastAuditId);
    allow update: if admin()
      && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['role','active','updatedAt','lastAuditId'])
      && request.resource.data.email == email
      && validRole(request.resource.data.role)
      && request.resource.data.active is bool
      && request.resource.data.updatedAt == request.time
      && request.resource.data.lastAuditId != resource.data.lastAuditId
      && hasAudit('invites/'+email,request.resource.data.lastAuditId);
    allow delete: if false;
  }

  match /member_audit/{id} {
    allow read: if admin();
    allow create: if admin()
      && request.resource.data.keys().hasOnly(['target','action','actorUid','occurredAt','details'])
      && request.resource.data.actorUid == request.auth.uid
      && request.resource.data.occurredAt == request.time
      && request.resource.data.target is string
      && request.resource.data.target.matches('^(members|invites)/[^/]+$')
      && request.resource.data.action in ['invite','role_change','disable','enable','invite_revoke','invite_enable']
      && request.resource.data.details is string
      && request.resource.data.details.size() <= 800;
    allow update, delete: if false;
  }


  match /operations/{id} {
    allow read: if activeMember();
    allow create: if editor()
      && request.resource.data.keys().hasOnly([
        'date','kind','quantity','unit','name','code','spec','worker','note',
        'price','amount','previous','meter','group','nameZh','sourceSheet',
        'sourceRow','sourceFile','year','importId','createdBy','createdAt',
        'consumedQuantity','consumedUnit','costGroup','nameVi'
      ])
      && request.resource.data.keys().hasAll([
        'date','kind','quantity','unit','name','sourceFile','sourceSheet',
        'createdBy','createdAt','importId'
      ])
      && request.resource.data.date is string
      && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.kind in [
        'waste','water_in','water_out','stock_in','stock_out','stock_opening',
        'water_cost_month','water_cost_reference','water_cost_total','water_cost_rate_reference',
        'green_cost_detail','green_cost_total','monthly_master',
        'waste_finance_month','monthly_reference',
        'waste_detail_reference','scrap_detail_reference'
      ]
      && request.resource.data.quantity is number
      && request.resource.data.quantity >= 0
      && request.resource.data.unit is string
      && request.resource.data.unit.size() <= 50
      && request.resource.data.name is string
      && request.resource.data.name.size() <= 300
      && request.resource.data.code is string
      && request.resource.data.code.size() <= 100
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 1400
      && request.resource.data.sourceFile is string
      && request.resource.data.sourceFile.size() <= 300
      && request.resource.data.sourceSheet is string
      && request.resource.data.sourceSheet.size() <= 120
      && request.resource.data.importId is string
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if admin();
  }

  match /records/{id} {
    allow read: if activeMember();
    allow create: if editor()
      && request.resource.data.keys().hasOnly(['date','kind','value','unit','name','note','source','createdBy','createdAt'])
      && validEntry(request.resource.data);
    allow update: if false;
    allow delete: if admin();
  }
  match /reviews/{id} {
    allow read: if activeMember();
    allow create: if editor()
      && request.resource.data.keys().hasOnly(['date','kind','value','unit','name','note','source','createdBy','createdAt','status'])
      && request.resource.data.status == 'pending'
      && validEntry(request.resource.data);
    allow update: if admin()
      && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
      && request.resource.data.status in ['approved','rejected']
      && request.resource.data.reviewedBy == request.auth.uid
      && request.resource.data.reviewedAt == request.time;
    allow delete: if admin();
  }
  match /data_reset_audit/{id} {
    allow read: if admin();
    allow create: if admin()
      && request.resource.data.action in ['reset_start','reset_complete']
      && request.resource.data.actorUid == request.auth.uid
      && request.resource.data.status in ['started','completed']
      && request.resource.data.keys().hasOnly([
        'action','actorUid','actorEmail','startedAt','completedAt','recordCounts',
        'total','deleted','startedAuditId','status'
      ])
      && (
        (request.resource.data.action=='reset_start'
          && request.resource.data.startedAt==request.time)
        ||
        (request.resource.data.action=='reset_complete'
          && request.resource.data.completedAt==request.time)
      );
    allow update, delete: if false;
  }

  match /ghg_activities/{id} {
    allow read: if activeMember();
    allow create: if editor()
      && request.resource.data.keys().hasOnly([
        'date','scope','activity','quantity','unit','factor','factorYear',
        'factorSource','createdBy','createdAt'
      ])
      && request.resource.data.keys().hasAll([
        'date','scope','activity','quantity','unit','factor','factorYear',
        'factorSource','createdBy','createdAt'
      ])
      && request.resource.data.date is string
      && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.scope in ['1','2','3']
      && request.resource.data.activity is string
      && request.resource.data.activity.size() > 0
      && request.resource.data.activity.size() <= 200
      && request.resource.data.quantity is number
      && request.resource.data.quantity >= 0
      && request.resource.data.unit is string
      && request.resource.data.unit.size() > 0
      && request.resource.data.unit.size() <= 40
      && (request.resource.data.factor == null
          || (request.resource.data.factor is number
              && request.resource.data.factor >= 0
              && request.resource.data.factorYear is string
              && request.resource.data.factorYear.matches('^[0-9]{4}$')
              && request.resource.data.factorSource is string
              && request.resource.data.factorSource.size() > 0))
      && request.resource.data.factorYear is string
      && request.resource.data.factorYear.size() <= 4
      && request.resource.data.factorSource is string
      && request.resource.data.factorSource.size() <= 500
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
  }

  match /settings/{id} {
    allow read: if activeMember();
    allow write: if admin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
